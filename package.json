{
  "name": "trustguard-battery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22.0.0 <23.0.0", "npm": ">=10.0.0" },
  "workspaces": ["apps/web", "services/api"],
  "scripts": {
    "build": "npm run build --workspace @trustguard/api && npm run build --workspace @trustguard/web",
    "check:env": "node tests/environment.mjs",
    "verify:fabric": "npm run verify:fabric --workspace @trustguard/api"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
