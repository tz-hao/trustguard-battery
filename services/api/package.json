{
  "name": "@trustguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:fabric": "node scripts/verify-fabric.mjs",
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/main.js",
    "start:keys": "node dist/key-broker.js",
    "start:indexer": "node dist/index-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@grpc/grpc-js": "1.14.7",
    "@hyperledger/fabric-gateway": "1.13.0",
    "@hyperledger/fabric-protos": "0.3.7",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
